{
  "type": "module",
  "name": "oasprey",
  "version": "1.0.2",
  "description": "Jest matchers for testing OpenAPI specifications",
  "keywords": [
    "jest",
    "openapi",
    "testing",
    "api",
    "validation"
  ],
  "homepage": "https://github.com/grove-platform/OASprey#readme",
  "bugs": {
    "url": "https://github.com/grove-platform/OASprey/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grove-platform/OASprey.git"
  },
  "license": "MIT",
  "author": "Grove Platform",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist coverage",
    "format": "prettier --write .",
    "lint": "eslint 'src/**/*.{js,ts}' 'tests/**/*.{js,ts}'",
    "build": "tsc",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck:all && npm run test && npm run build",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "typecheck:common": "tsc --project tsconfig.commonTestResources.json",
    "typecheck:all": "npm run typecheck:tests && npm run typecheck:common",
    "coverage": "jest --coverage --coverageThreshold='{\"global\": {\"branches\": 80, \"functions\": 80, \"lines\": 80, \"statements\": 80}}'"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "express": "^5.2.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "fast-uri": "3.1.8",
    "js-yaml@<4": "3.15.2",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
    "minimatch@<4": "3.1.3",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "minimatch@>=10.0.0 <10.2.3": "10.2.3",
    "qs": "6.15.2",
    "browserslist": "4.28.7",
    "@humanfs/node": "0.16.8",
    "form-data": "4.0.6",
    "picomatch@<3": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "flatted": "3.4.2",
    "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
    "follow-redirects": "1.16.0",
    "@babel/core": "7.29.6"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cartesian-product": "^2.1.2",
    "fs-extra": "11.3.3",
    "jest-matcher-utils": "^30.2.0",
    "js-yaml": "^4.3.2",
    "openapi-response-validator": "^12.1.3",
    "openapi-schema-validator": "^12.1.3",
    "openapi-types": "^12.1.3",
    "path-to-regexp": "^8.4.2"
  }
}
